<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base Application Theme -->
    <style name="Theme.SecureVPN" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:statusBarColor">@color/colorBackground</item>
        <item name="android:navigationBarColor">@color/colorBackground</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/colorTextPrimary</item>
        <item name="android:textColorSecondary">@color/colorTextSecondary</item>
        <item name="materialAlertDialogTheme">@style/MaterialAlertDialog.SecureVPN</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.SecureVPN.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/colorBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_vpn_shield</item>
        <item name="postSplashScreenTheme">@style/Theme.SecureVPN</item>
    </style>

    <!-- AppBar Style -->
    <style name="Widget.SecureVPN.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/colorSurface</item>
        <item name="titleTextColor">@color/colorTextPrimary</item>
        <item name="subtitleTextColor">@color/colorTextSecondary</item>
    </style>

    <!-- Card Style -->
    <style name="Widget.SecureVPN.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/colorCardBackground</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/colorBorder</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Card Style Selected -->
    <style name="Widget.SecureVPN.Card.Selected" parent="Widget.SecureVPN.Card">
        <item name="strokeColor">@color/colorPrimary</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <!-- Bottom Navigation Style -->
    <style name="Widget.SecureVPN.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/colorSurface</item>
        <item name="itemIconTint">@color/bottom_nav_color_selector</item>
        <item name="itemTextColor">@color/bottom_nav_color_selector</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <!-- Button Style -->
    <style name="Widget.SecureVPN.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
    </style>

    <!-- TextInput Style -->
    <style name="Widget.SecureVPN.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/colorBorder</item>
        <item name="boxBackgroundColor">@color/colorSearchBackground</item>
        <item name="hintTextColor">@color/colorTextHint</item>
        <item name="android:textColorHint">@color/colorTextHint</item>
        <item name="boxCornerRadiusTopStart">@dimen/search_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/search_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/search_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/search_corner_radius</item>
    </style>

    <!-- Alert Dialog -->
    <style name="MaterialAlertDialog.SecureVPN" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:background">@color/colorSurface</item>
        <item name="android:textColorPrimary">@color/colorTextPrimary</item>
        <item name="colorOnSurface">@color/colorTextSecondary</item>
    </style>

</resources>
