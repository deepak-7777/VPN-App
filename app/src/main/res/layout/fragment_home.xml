<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- Shield icon + App name -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="start">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_vpn_shield"
                    android:contentDescription="@string/app_name" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="@dimen/text_size_xl"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- Guest badge on right -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="@string/label_guest_mode"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/text_size_sm"
                android:background="@drawable/bg_free_badge"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginEnd="8dp" />

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_lg">

            <!-- Connection Status Banner -->
            <LinearLayout
                android:id="@+id/ll_status_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_status_disconnected"
                android:paddingStart="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md"
                android:paddingTop="@dimen/spacing_xs"
                android:paddingBottom="@dimen/spacing_xs"
                android:layout_marginBottom="@dimen/spacing_lg">

                <!-- Status Dot -->
                <View
                    android:id="@+id/v_status_dot"
                    android:layout_width="@dimen/status_dot_size"
                    android:layout_height="@dimen/status_dot_size"
                    android:background="#F85149"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tv_connection_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_disconnected"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="@dimen/text_size_md"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Connect Button centered -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl">

                <!-- Outer ring (pulse effect placeholder) -->
                <ImageView
                    android:id="@+id/iv_button_ring"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center"
                    android:src="@drawable/connect_button_ring"
                    android:alpha="0.6" />

                <!-- Main Connect Button -->
                <LinearLayout
                    android:id="@+id/btn_connect"
                    android:layout_width="@dimen/connect_button_size"
                    android:layout_height="@dimen/connect_button_size"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/connect_button_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/cd_connect_button">

                    <ImageView
                        android:id="@+id/iv_connect_icon"
                        android:layout_width="@dimen/connect_button_icon_size"
                        android:layout_height="@dimen/connect_button_icon_size"
                        android:src="@drawable/ic_vpn_shield"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tv_btn_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_connect"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_lg"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </FrameLayout>

            <!-- Session Timer -->
            <TextView
                android:id="@+id/tv_session_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:text="@string/label_time_placeholder"
                android:textColor="@color/colorTextSecondary"
                android:textSize="@dimen/text_size_xxl"
                android:fontFamily="monospace"
                android:layout_marginStart="0dp"
                android:gravity="center" />

            <!-- Upload / Download Stats Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_md">

                <!-- Download Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_stat_card"
                    android:padding="@dimen/spacing_md"
                    android:layout_marginEnd="6dp">

                    <ImageView
                        android:layout_width="@dimen/icon_size_md"
                        android:layout_height="@dimen/icon_size_md"
                        android:src="@drawable/ic_download"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tv_download_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_speed_placeholder"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="@dimen/text_size_md"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_download"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/text_size_xs" />

                </LinearLayout>

                <!-- Upload Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_stat_card"
                    android:padding="@dimen/spacing_md"
                    android:layout_marginStart="6dp">

                    <ImageView
                        android:layout_width="@dimen/icon_size_md"
                        android:layout_height="@dimen/icon_size_md"
                        android:src="@drawable/ic_upload"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tv_upload_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_speed_placeholder"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="@dimen/text_size_md"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_upload"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/text_size_xs" />

                </LinearLayout>

            </LinearLayout>

            <!-- Current IP Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:cardCornerRadius="@dimen/card_corner_radius_small"
                app:cardElevation="0dp"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_current_ip"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/text_size_sm" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tv_current_ip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_ip_placeholder"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="@dimen/text_size_md"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Selected Server Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_selected_server"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/colorPrimary"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_selected_server"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="@dimen/text_size_sm" />

                        <TextView
                            android:id="@+id/tv_change_server"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_change_server"
                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/text_size_sm"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Flag placeholder -->
                        <TextView
                            android:id="@+id/tv_server_flag"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:text="🇺🇸"
                            android:textSize="22sp"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_server_country"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="United States"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="@dimen/text_size_lg"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_server_city"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="New York"
                                android:textColor="@color/colorTextSecondary"
                                android:textSize="@dimen/text_size_sm" />

                        </LinearLayout>

                        <!-- FREE badge -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_free"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_size_xs"
                            android:textStyle="bold"
                            android:background="@drawable/bg_free_badge"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:layout_marginEnd="8dp" />

                        <!-- Ping -->
                        <TextView
                            android:id="@+id/tv_server_ping"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="42 ms"
                            android:textColor="@color/colorConnected"
                            android:textSize="@dimen/text_size_sm"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Ad Banner Placeholder (future AdMob) -->
            <FrameLayout
                android:id="@+id/fl_ad_container"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ad_banner_height"
                android:layout_marginTop="@dimen/spacing_sm"
                android:visibility="gone">
                <!--
                    TODO: AdMob Banner Integration
                    Add AdView here when ready:
                    <com.google.android.gms.ads.AdView
                        android:id="@+id/adView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        ads:adSize="BANNER"
                        ads:adUnitId="@string/banner_ad_unit_id" />
                -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Ad Space (Coming Soon)"
                    android:textColor="@color/colorTextHint"
                    android:textSize="@dimen/text_size_sm"
                    android:background="@color/colorSurfaceVariant" />
            </FrameLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Loading overlay -->
    <FrameLayout
        android:id="@+id/fl_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorOverlay"
        android:visibility="gone"
        android:clickable="true">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/colorPrimary" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
