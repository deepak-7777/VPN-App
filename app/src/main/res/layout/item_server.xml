<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_server_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/card_margin_horizontal"
    android:layout_marginEnd="@dimen/card_margin_horizontal"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/colorCardBackground"
    app:cardCornerRadius="@dimen/card_corner_radius_small"
    app:cardElevation="0dp"
    app:strokeColor="@color/colorBorder"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/server_item_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md">

        <!-- Country Flag emoji -->
        <TextView
            android:id="@+id/tv_flag"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:textSize="22sp"
            android:layout_marginEnd="@dimen/spacing_sm" />

        <!-- Country + City -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_country"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/text_size_md"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorTextSecondary"
                android:textSize="@dimen/text_size_sm"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- FREE badge -->
        <TextView
            android:id="@+id/tv_free_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_free"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_xs"
            android:textStyle="bold"
            android:background="@drawable/bg_free_badge"
            android:paddingStart="@dimen/badge_padding_horizontal"
            android:paddingEnd="@dimen/badge_padding_horizontal"
            android:paddingTop="@dimen/badge_padding_vertical"
            android:paddingBottom="@dimen/badge_padding_vertical"
            android:layout_marginEnd="@dimen/spacing_xs"
            android:visibility="visible" />

        <!-- Ping -->
        <TextView
            android:id="@+id/tv_ping"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/colorConnected"
            android:textSize="@dimen/text_size_sm"
            android:textStyle="bold"
            android:layout_marginEnd="@dimen/spacing_xs" />

        <!-- Signal icon -->
        <ImageView
            android:id="@+id/iv_signal"
            android:layout_width="@dimen/icon_size_sm"
            android:layout_height="@dimen/icon_size_sm"
            android:src="@drawable/ic_signal_full"
            android:layout_marginEnd="@dimen/spacing_xs"
            android:contentDescription="@string/cd_signal_strength" />

        <!-- Selected check -->
        <ImageView
            android:id="@+id/iv_selected"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_check_circle"
            android:visibility="gone"
            android:contentDescription="@null" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
